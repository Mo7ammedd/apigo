{
  "name": "apigo",
  "version": "0.1.0",
  "description": "An OpenAPI-native API client for your terminal.",
  "type": "module",
  "bin": {
    "apigo": "./dist/index.js"
  },
  "files": ["dist", "docs/assets", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "license": "MIT",
  "author": "mo7ammedd",
  "homepage": "https://github.com/Mo7ammedd/apigo#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Mo7ammedd/apigo.git" },
  "bugs": { "url": "https://github.com/Mo7ammedd/apigo/issues" },
  "keywords": ["openapi", "swagger", "api", "cli", "http", "aspnet", "postman"],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup && node scripts/executable.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^14.2.1",
    "@inquirer/prompts": "^7.10.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "ora": "^8.2.0",
    "undici": "^7.24.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "eslint": "^10.10.0",
    "globals": "^17.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^5.0.1"
  }
}
