{
  "swagger": "2.0", "info": { "title": "Legacy Inventory API", "version": "1.0" },
  "host": "localhost:5000", "basePath": "/v1", "schemes": ["http"],
  "consumes": ["application/json"], "produces": ["application/json"],
  "securityDefinitions": { "ApiKey": { "type": "apiKey", "name": "X-API-Key", "in": "header" }, "Basic": { "type": "basic" } },
  "security": [{ "ApiKey": [] }],
  "paths": {
    "/items": {
      "get": { "tags": ["Items"], "operationId": "listItems", "parameters": [{ "name": "ids", "in": "query", "type": "array", "items": { "type": "integer" }, "collectionFormat": "csv" }], "responses": { "200": { "description": "Items", "schema": { "type": "array", "items": { "$ref": "#/definitions/Item" } } } } },
      "post": { "tags": ["Items"], "parameters": [{ "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/Item" } }], "responses": { "201": { "description": "Created" } } }
    }
  },
  "definitions": { "Item": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "quantity": { "type": "integer", "minimum": 0 } } } }
}
